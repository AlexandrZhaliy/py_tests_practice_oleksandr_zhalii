# postgreSQL database URL to keep .env secret-carrying good-practices
# for local run (postgres started via `docker run`, port published as 5433):
DATABASE_URL=postgresql://testuser:testpassword@localhost:5433/testdb

# for run inside a docker container connected to postgres via a docker network
# (postgres container name used as host, default internal port 5432):
# DATABASE_URL=postgresql://testuser:testpassword@hw29-postgres:5432/testdb
